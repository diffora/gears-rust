{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OAGW upstream credential (proposed)",
  "description": "Root: create. Definitions: replace, suspension, registry, response and list. Internal pins, versions and limit generations never appear in wire models.",
  "definitions": {
    "name": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_-]{0,62}$",
      "not": {
        "anyOf": [
          {
            "const": "default"
          },
          {
            "pattern": "[^a-z0-9_-]"
          }
        ]
      }
    },
    "secret_ref": {
      "type": "string",
      "pattern": "^(cred://)?[A-Za-z0-9_-]{1,255}$",
      "not": {
        "pattern": "[\\r\\n]"
      },
      "description": "On create or change of reference, OAGW pins the UUID returned by CredStore. For an unchanged reference, a different record UUID cannot pass validation."
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_per_minute"
      ],
      "properties": {
        "requests_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "description": "OAGW assigns a fresh bucket generation when this limit takes effect or its rate changes."
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "default": [],
      "items": {
        "type": "string",
        "maxLength": 128,
        "not": {
          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
        }
      },
      "description": "Existing upstream tag validation also enforces a maximum of 128 UTF-8 bytes per tag."
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "secret_ref"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "secret_ref": {
          "$ref": "#/definitions/secret_ref"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "rate_limit": {
          "$ref": "#/definitions/rate_limit"
        },
        "tags": {
          "$ref": "#/definitions/tags"
        }
      },
      "examples": [
        {
          "name": "research",
          "secret_ref": "cred://openai-research",
          "rate_limit": {
            "requests_per_minute": 60
          }
        }
      ]
    },
    "replace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_ref"
      ],
      "properties": {
        "secret_ref": {
          "$ref": "#/definitions/secret_ref"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "rate_limit": {
          "$ref": "#/definitions/rate_limit"
        },
        "tags": {
          "$ref": "#/definitions/tags"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_id",
        "name",
        "secret_ref"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "secret_ref": {
          "$ref": "#/definitions/secret_ref"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "rate_limit": {
          "$ref": "#/definitions/rate_limit"
        },
        "tags": {
          "$ref": "#/definitions/tags"
        },
        "upstream_id": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of a registry-managed upstream in this tenant. The reconciler checks the parent's stored ownership."
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "suspension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suspended"
      ],
      "properties": {
        "suspended": {
          "type": "boolean",
          "description": "True suspends immediately without reading CredStore. False requests resumption after full validation."
        }
      }
    },
    "credential_id": {
      "type": "string",
      "format": "gts-identifier",
      "pattern": "^gts\\.cf\\.core\\.oagw\\.credential\\.v1~[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "upstream_id": {
      "type": "string",
      "format": "gts-identifier",
      "pattern": "^gts\\.cf\\.core\\.oagw\\.upstream\\.v1~[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "host",
        "port"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "https",
            "wss",
            "wt",
            "grpc"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tenant_id",
        "upstream_id",
        "name",
        "secret_ref",
        "enabled",
        "suspended",
        "managed_by",
        "approved_endpoints",
        "tags",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/credential_id"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "upstream_id": {
          "$ref": "#/definitions/upstream_id"
        },
        "name": {
          "$ref": "#/definitions/name"
        },
        "secret_ref": {
          "$ref": "#/definitions/secret_ref"
        },
        "enabled": {
          "type": "boolean"
        },
        "suspended": {
          "type": "boolean"
        },
        "managed_by": {
          "enum": [
            "api",
            "registry"
          ]
        },
        "approved_endpoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/endpoint"
          }
        },
        "rate_limit": {
          "$ref": "#/definitions/rate_limit"
        },
        "tags": {
          "$ref": "#/definitions/tags"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "description": "REST resource returned by GET/POST/PUT/PATCH. Internal record pin, row version, registry source UUID and generation are absent."
    },
    "list": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/response"
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/create"
    }
  ]
}
