{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OAGW credential binding (proposed)",
  "description": "The document root validates a create request. PUT and Types Registry use the replace and registry definitions respectively. Read-only fields are produced by OAGW.",
  "$ref": "#/definitions/create",
  "definitions": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_-]{0,62}$",
      "not": {
        "anyOf": [
          {
            "const": "default"
          },
          {
            "pattern": "[^a-z0-9_-]"
          }
        ]
      }
    },
    "secret_ref": {
      "type": "string",
      "pattern": "^(cred://)?[A-Za-z0-9_-]{1,255}$",
      "not": {
        "pattern": "[\\r\\n]"
      },
      "description": "A CredStore key, optionally prefixed with cred://. OAGW validates access under the acting security context."
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_per_minute"
      ],
      "properties": {
        "requests_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "default": [],
      "items": {
        "type": "string",
        "maxLength": 128,
        "not": {
          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
        }
      },
      "description": "Existing upstream tag validation also enforces a maximum of 128 UTF-8 bytes per tag."
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "secret_ref"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "secret_ref": {
          "$ref": "#/definitions/secret_ref"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "rate_limit": {
          "$ref": "#/definitions/rate_limit"
        },
        "tags": {
          "$ref": "#/definitions/tags"
        }
      }
    },
    "replace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_ref"
      ],
      "properties": {
        "secret_ref": {
          "$ref": "#/definitions/secret_ref"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "rate_limit": {
          "$ref": "#/definitions/rate_limit"
        },
        "tags": {
          "$ref": "#/definitions/tags"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_id",
        "name",
        "secret_ref"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "secret_ref": {
          "$ref": "#/definitions/secret_ref"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "rate_limit": {
          "$ref": "#/definitions/rate_limit"
        },
        "tags": {
          "$ref": "#/definitions/tags"
        },
        "upstream_id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  },
  "examples": [
    {
      "name": "research",
      "secret_ref": "cred://openai-research",
      "rate_limit": {
        "requests_per_minute": 60
      }
    }
  ]
}
